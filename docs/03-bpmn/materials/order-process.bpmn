<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AmurTrans" targetNamespace="https://petkras.github.io/amurtrans-kontrol/bpmn">
  <collaboration id="Collaboration_Order">
    <participant id="Participant_Order" name="АмурТранс — обработка заказа" processRef="Process_Order" />
  </collaboration>
  <process id="Process_Order" name="Обработка заказа на перевозку" isExecutable="false">
    <laneSet id="LaneSet_Order">
      <lane id="Lane_0" name="Клиент">
        <flowNodeRef>Start_Request</flowNodeRef>
        <flowNodeRef>Task_Request</flowNodeRef>
        <flowNodeRef>Task_Clarify</flowNodeRef>
        <flowNodeRef>Task_Approve</flowNodeRef>
        <flowNodeRef>Gateway_Approved</flowNodeRef>
        <flowNodeRef>Gateway_Revise</flowNodeRef>
      </lane>
      <lane id="Lane_1" name="Менеджер">
        <flowNodeRef>Task_Register</flowNodeRef>
        <flowNodeRef>Gateway_Complete</flowNodeRef>
        <flowNodeRef>Task_Ask</flowNodeRef>
        <flowNodeRef>Task_Offer</flowNodeRef>
        <flowNodeRef>Task_Cancel</flowNodeRef>
        <flowNodeRef>End_Declined</flowNodeRef>
        <flowNodeRef>Gateway_Claim</flowNodeRef>
        <flowNodeRef>Task_Claim</flowNodeRef>
        <flowNodeRef>Task_ClaimResolve</flowNodeRef>
      </lane>
      <lane id="Lane_2" name="Логист">
        <flowNodeRef>Task_Check</flowNodeRef>
        <flowNodeRef>Gateway_Feasible</flowNodeRef>
        <flowNodeRef>Task_Calculate</flowNodeRef>
        <flowNodeRef>Task_Reject</flowNodeRef>
        <flowNodeRef>End_Rejected</flowNodeRef>
        <flowNodeRef>Task_Recalculate</flowNodeRef>
      </lane>
      <lane id="Lane_3" name="Диспетчер">
        <flowNodeRef>Task_Assign</flowNodeRef>
        <flowNodeRef>Gateway_Assigned</flowNodeRef>
        <flowNodeRef>Task_Alternative</flowNodeRef>
        <flowNodeRef>Task_Monitor</flowNodeRef>
        <flowNodeRef>Gateway_Incident</flowNodeRef>
        <flowNodeRef>Task_Incident</flowNodeRef>
        <flowNodeRef>Task_Resolve</flowNodeRef>
      </lane>
      <lane id="Lane_4" name="Водитель">
        <flowNodeRef>Task_Route</flowNodeRef>
        <flowNodeRef>Task_Arrival</flowNodeRef>
        <flowNodeRef>Task_Load</flowNodeRef>
        <flowNodeRef>Task_Continue</flowNodeRef>
        <flowNodeRef>Gateway_Resolved</flowNodeRef>
        <flowNodeRef>Task_Deliver</flowNodeRef>
        <flowNodeRef>Task_Proof</flowNodeRef>
        <flowNodeRef>Task_Documents</flowNodeRef>
      </lane>
      <lane id="Lane_5" name="Бухгалтерия">
        <flowNodeRef>Task_Invoice</flowNodeRef>
        <flowNodeRef>Task_Payment</flowNodeRef>
        <flowNodeRef>Task_Close</flowNodeRef>
        <flowNodeRef>End_Closed</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Request" name="Потребность в перевозке">
      <outgoing>Flow_01</outgoing>
    </startEvent>
    <task id="Task_Request" name="Передать заявку">
      <documentation>Бот собирает обязательные поля и показывает сводку. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_01</incoming>
      <outgoing>Flow_02</outgoing>
    </task>
    <task id="Task_Register" name="Зарегистрировать и проверить заявку">
      <documentation>Карточка заказа, проверка полей, история уточнений. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_02</incoming>
      <incoming>Flow_43</incoming>
      <outgoing>Flow_03</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Complete" name="Данные полные?">
      <incoming>Flow_03</incoming>
      <outgoing>Flow_27</outgoing>
      <outgoing>Flow_28</outgoing>
    </exclusiveGateway>
    <task id="Task_Ask" name="Запросить недостающие данные">
      <documentation>Запрос только отсутствующих или некорректных полей. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_27</incoming>
      <outgoing>Flow_04</outgoing>
    </task>
    <task id="Task_Clarify" name="Дополнить заявку">
      <incoming>Flow_04</incoming>
      <outgoing>Flow_43</outgoing>
    </task>
    <task id="Task_Check" name="Проверить возможность перевозки">
      <documentation>Карточка груза, ограничения маршрута и временного окна. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_28</incoming>
      <outgoing>Flow_05</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Feasible" name="Перевозка возможна?">
      <incoming>Flow_05</incoming>
      <outgoing>Flow_29</outgoing>
      <outgoing>Flow_30</outgoing>
    </exclusiveGateway>
    <task id="Task_Calculate" name="Рассчитать маршрут, срок и стоимость">
      <documentation>Версия расчёта и предложение; решение утверждает логист. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_30</incoming>
      <outgoing>Flow_07</outgoing>
    </task>
    <task id="Task_Reject" name="Зафиксировать причину отказа">
      <incoming>Flow_29</incoming>
      <outgoing>Flow_06</outgoing>
    </task>
    <endEvent id="End_Rejected" name="Перевозка отклонена">
      <incoming>Flow_06</incoming>
    </endEvent>
    <task id="Task_Offer" name="Направить условия клиенту">
      <documentation>Согласуемая версия предложения. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_07</incoming>
      <incoming>Flow_44</incoming>
      <outgoing>Flow_08</outgoing>
    </task>
    <task id="Task_Approve" name="Рассмотреть предложение">
      <incoming>Flow_08</incoming>
      <outgoing>Flow_09</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Approved" name="Условия приняты?">
      <incoming>Flow_09</incoming>
      <outgoing>Flow_31</outgoing>
      <outgoing>Flow_32</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Revise" name="Нужны изменения?">
      <incoming>Flow_31</incoming>
      <outgoing>Flow_33</outgoing>
      <outgoing>Flow_34</outgoing>
    </exclusiveGateway>
    <task id="Task_Recalculate" name="Изменить расчёт и условия">
      <documentation>Новая версия расчёта; прежнее согласование не переносится. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_33</incoming>
      <outgoing>Flow_44</outgoing>
    </task>
    <task id="Task_Cancel" name="Зафиксировать отмену заказа">
      <incoming>Flow_34</incoming>
      <outgoing>Flow_10</outgoing>
    </task>
    <endEvent id="End_Declined" name="Заказ отменён">
      <incoming>Flow_10</incoming>
    </endEvent>
    <task id="Task_Assign" name="Назначить автомобиль и водителя">
      <documentation>Назначение ресурсов и план рейса. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_32</incoming>
      <incoming>Flow_45</incoming>
      <outgoing>Flow_11</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Assigned" name="Ресурсы назначены?">
      <incoming>Flow_11</incoming>
      <outgoing>Flow_35</outgoing>
      <outgoing>Flow_36</outgoing>
    </exclusiveGateway>
    <task id="Task_Alternative" name="Подобрать другой транспорт или водителя">
      <incoming>Flow_35</incoming>
      <outgoing>Flow_45</outgoing>
    </task>
    <task id="Task_Route" name="Получить маршрут и документы">
      <incoming>Flow_36</incoming>
      <outgoing>Flow_12</outgoing>
    </task>
    <task id="Task_Arrival" name="Прибыть на погрузку">
      <incoming>Flow_12</incoming>
      <outgoing>Flow_13</outgoing>
    </task>
    <task id="Task_Load" name="Принять груз и начать рейс">
      <documentation>Фактическая погрузка, отметка «В пути». Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_13</incoming>
      <outgoing>Flow_14</outgoing>
    </task>
    <task id="Task_Monitor" name="Контролировать рейс и события">
      <documentation>События, статусы и журнал инцидентов; GPS-интеграция не заявляется. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_14</incoming>
      <incoming>Flow_42</incoming>
      <outgoing>Flow_15</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Incident" name="Есть отклонение?">
      <incoming>Flow_15</incoming>
      <outgoing>Flow_37</outgoing>
      <outgoing>Flow_38</outgoing>
    </exclusiveGateway>
    <task id="Task_Incident" name="Создать карточку инцидента">
      <incoming>Flow_37</incoming>
      <outgoing>Flow_16</outgoing>
    </task>
    <task id="Task_Resolve" name="Согласовать решение по инциденту">
      <incoming>Flow_16</incoming>
      <incoming>Flow_39</incoming>
      <outgoing>Flow_17</outgoing>
    </task>
    <task id="Task_Continue" name="Продолжить рейс по согласованному решению">
      <documentation>После продолжения рейса диспетчер повторно проверяет статус и события. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_17</incoming>
      <outgoing>Flow_18</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Resolved" name="Отклонение устранено?">
      <documentation>Да — вернуться к контролю рейса; Нет — повторно согласовать решение. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_18</incoming>
      <outgoing>Flow_39</outgoing>
      <outgoing>Flow_42</outgoing>
    </exclusiveGateway>
    <task id="Task_Deliver" name="Доставить груз">
      <incoming>Flow_38</incoming>
      <outgoing>Flow_19</outgoing>
    </task>
    <task id="Task_Proof" name="Получить подтверждение доставки">
      <documentation>Подписанная ТТН / УПД или электронное подтверждение. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_19</incoming>
      <outgoing>Flow_20</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Claim" name="Есть претензия?">
      <incoming>Flow_20</incoming>
      <outgoing>Flow_40</outgoing>
      <outgoing>Flow_41</outgoing>
    </exclusiveGateway>
    <task id="Task_Claim" name="Зарегистрировать претензию и доказательства">
      <incoming>Flow_40</incoming>
      <outgoing>Flow_21</outgoing>
    </task>
    <task id="Task_ClaimResolve" name="Обработать претензию и зафиксировать решение">
      <documentation>Результат урегулирования; до него заказ не закрывается. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_21</incoming>
      <outgoing>Flow_22</outgoing>
    </task>
    <task id="Task_Documents" name="Передать закрывающие документы">
      <incoming>Flow_22</incoming>
      <incoming>Flow_41</incoming>
      <outgoing>Flow_23</outgoing>
    </task>
    <task id="Task_Invoice" name="Проверить документы и выставить счёт">
      <documentation>Комплект документов, счёт и срок оплаты. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_23</incoming>
      <outgoing>Flow_24</outgoing>
    </task>
    <task id="Task_Payment" name="Проверить оплату или передачу задолженности">
      <documentation>Основание закрытия согласно правилам Wiki. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_24</incoming>
      <outgoing>Flow_25</outgoing>
    </task>
    <task id="Task_Close" name="Закрыть заказ">
      <documentation>Финальный статус после документов и урегулирования. Ответственное лицо сохраняет право принятия решения.</documentation>
      <incoming>Flow_25</incoming>
      <outgoing>Flow_26</outgoing>
    </task>
    <endEvent id="End_Closed" name="Заказ закрыт">
      <incoming>Flow_26</incoming>
    </endEvent>
    <sequenceFlow id="Flow_01" sourceRef="Start_Request" targetRef="Task_Request" />
    <sequenceFlow id="Flow_02" sourceRef="Task_Request" targetRef="Task_Register" />
    <sequenceFlow id="Flow_03" sourceRef="Task_Register" targetRef="Gateway_Complete" />
    <sequenceFlow id="Flow_04" sourceRef="Task_Ask" targetRef="Task_Clarify" />
    <sequenceFlow id="Flow_05" sourceRef="Task_Check" targetRef="Gateway_Feasible" />
    <sequenceFlow id="Flow_06" sourceRef="Task_Reject" targetRef="End_Rejected" />
    <sequenceFlow id="Flow_07" sourceRef="Task_Calculate" targetRef="Task_Offer" />
    <sequenceFlow id="Flow_08" sourceRef="Task_Offer" targetRef="Task_Approve" />
    <sequenceFlow id="Flow_09" sourceRef="Task_Approve" targetRef="Gateway_Approved" />
    <sequenceFlow id="Flow_10" sourceRef="Task_Cancel" targetRef="End_Declined" />
    <sequenceFlow id="Flow_11" sourceRef="Task_Assign" targetRef="Gateway_Assigned" />
    <sequenceFlow id="Flow_12" sourceRef="Task_Route" targetRef="Task_Arrival" />
    <sequenceFlow id="Flow_13" sourceRef="Task_Arrival" targetRef="Task_Load" />
    <sequenceFlow id="Flow_14" sourceRef="Task_Load" targetRef="Task_Monitor" />
    <sequenceFlow id="Flow_15" sourceRef="Task_Monitor" targetRef="Gateway_Incident" />
    <sequenceFlow id="Flow_16" sourceRef="Task_Incident" targetRef="Task_Resolve" />
    <sequenceFlow id="Flow_17" sourceRef="Task_Resolve" targetRef="Task_Continue" />
    <sequenceFlow id="Flow_18" sourceRef="Task_Continue" targetRef="Gateway_Resolved" />
    <sequenceFlow id="Flow_19" sourceRef="Task_Deliver" targetRef="Task_Proof" />
    <sequenceFlow id="Flow_20" sourceRef="Task_Proof" targetRef="Gateway_Claim" />
    <sequenceFlow id="Flow_21" sourceRef="Task_Claim" targetRef="Task_ClaimResolve" />
    <sequenceFlow id="Flow_22" sourceRef="Task_ClaimResolve" targetRef="Task_Documents" />
    <sequenceFlow id="Flow_23" sourceRef="Task_Documents" targetRef="Task_Invoice" />
    <sequenceFlow id="Flow_24" sourceRef="Task_Invoice" targetRef="Task_Payment" />
    <sequenceFlow id="Flow_25" sourceRef="Task_Payment" targetRef="Task_Close" />
    <sequenceFlow id="Flow_26" sourceRef="Task_Close" targetRef="End_Closed" />
    <sequenceFlow id="Flow_27" sourceRef="Gateway_Complete" targetRef="Task_Ask" name="Нет" />
    <sequenceFlow id="Flow_28" sourceRef="Gateway_Complete" targetRef="Task_Check" name="Да" />
    <sequenceFlow id="Flow_29" sourceRef="Gateway_Feasible" targetRef="Task_Reject" name="Нет" />
    <sequenceFlow id="Flow_30" sourceRef="Gateway_Feasible" targetRef="Task_Calculate" name="Да" />
    <sequenceFlow id="Flow_31" sourceRef="Gateway_Approved" targetRef="Gateway_Revise" name="Нет" />
    <sequenceFlow id="Flow_32" sourceRef="Gateway_Approved" targetRef="Task_Assign" name="Да" />
    <sequenceFlow id="Flow_33" sourceRef="Gateway_Revise" targetRef="Task_Recalculate" name="Да" />
    <sequenceFlow id="Flow_34" sourceRef="Gateway_Revise" targetRef="Task_Cancel" name="Нет" />
    <sequenceFlow id="Flow_35" sourceRef="Gateway_Assigned" targetRef="Task_Alternative" name="Нет" />
    <sequenceFlow id="Flow_36" sourceRef="Gateway_Assigned" targetRef="Task_Route" name="Да" />
    <sequenceFlow id="Flow_37" sourceRef="Gateway_Incident" targetRef="Task_Incident" name="Да" />
    <sequenceFlow id="Flow_38" sourceRef="Gateway_Incident" targetRef="Task_Deliver" name="Нет" />
    <sequenceFlow id="Flow_39" sourceRef="Gateway_Resolved" targetRef="Task_Resolve" name="Нет" />
    <sequenceFlow id="Flow_40" sourceRef="Gateway_Claim" targetRef="Task_Claim" name="Да" />
    <sequenceFlow id="Flow_41" sourceRef="Gateway_Claim" targetRef="Task_Documents" name="Нет" />
    <sequenceFlow id="Flow_42" sourceRef="Gateway_Resolved" targetRef="Task_Monitor" name="Да" />
    <sequenceFlow id="Flow_43" sourceRef="Task_Clarify" targetRef="Task_Register" />
    <sequenceFlow id="Flow_44" sourceRef="Task_Recalculate" targetRef="Task_Offer" />
    <sequenceFlow id="Flow_45" sourceRef="Task_Alternative" targetRef="Task_Assign" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Order">
    <bpmndi:BPMNPlane id="Plane_Order" bpmnElement="Collaboration_Order">
      <bpmndi:BPMNShape id="Shape_Participant_Order" bpmnElement="Participant_Order" isHorizontal="true">
        <dc:Bounds x="0" y="60" width="8310" height="2225" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_0" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="30" y="60" width="8280" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_1" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="30" y="420" width="8280" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_2" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="30" y="780" width="8280" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_3" bpmnElement="Lane_3" isHorizontal="true">
        <dc:Bounds x="30" y="1140" width="8280" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_4" bpmnElement="Lane_4" isHorizontal="true">
        <dc:Bounds x="30" y="1500" width="8280" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_5" bpmnElement="Lane_5" isHorizontal="true">
        <dc:Bounds x="30" y="1860" width="8280" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Request" bpmnElement="Start_Request">
        <dc:Bounds x="180" y="100" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Request" bpmnElement="Task_Request">
        <dc:Bounds x="400" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Register" bpmnElement="Task_Register">
        <dc:Bounds x="620" y="460" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Complete" bpmnElement="Gateway_Complete">
        <dc:Bounds x="840" y="460" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Ask" bpmnElement="Task_Ask">
        <dc:Bounds x="1060" y="580" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Clarify" bpmnElement="Task_Clarify">
        <dc:Bounds x="1280" y="220" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Check" bpmnElement="Task_Check">
        <dc:Bounds x="1600" y="820" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Feasible" bpmnElement="Gateway_Feasible">
        <dc:Bounds x="1820" y="820" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Calculate" bpmnElement="Task_Calculate">
        <dc:Bounds x="2040" y="820" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Reject" bpmnElement="Task_Reject">
        <dc:Bounds x="2040" y="940" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Rejected" bpmnElement="End_Rejected">
        <dc:Bounds x="2090" y="1050" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Offer" bpmnElement="Task_Offer">
        <dc:Bounds x="2580" y="460" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Approve" bpmnElement="Task_Approve">
        <dc:Bounds x="2800" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Approved" bpmnElement="Gateway_Approved">
        <dc:Bounds x="3020" y="100" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Revise" bpmnElement="Gateway_Revise">
        <dc:Bounds x="3240" y="220" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Recalculate" bpmnElement="Task_Recalculate">
        <dc:Bounds x="2800" y="940" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cancel" bpmnElement="Task_Cancel">
        <dc:Bounds x="3460" y="580" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Declined" bpmnElement="End_Declined">
        <dc:Bounds x="3510" y="690" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Assign" bpmnElement="Task_Assign">
        <dc:Bounds x="4000" y="1180" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Assigned" bpmnElement="Gateway_Assigned">
        <dc:Bounds x="4220" y="1180" width="60" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Alternative" bpmnElement="Task_Alternative">
        <dc:Bounds x="4000" y="1300" width="160" height="80" />
      </bpmndi:BPMNShape>
