<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AmurTrans" targetNamespace="https://petkras.github.io/amurtrans-kontrol/bpmn">
  <collaboration id="Collaboration_Order"><participant id="Participant_Order" name="Обработка заказа на перевозку" processRef="Process_Order" /></collaboration>
  <process id="Process_Order" name="Обработка заказа транспортной компании" isExecutable="false">
    <laneSet id="LaneSet_Order">
      <lane id="Lane_Client" name="Клиент"><flowNodeRef>Start_Request</flowNodeRef><flowNodeRef>Task_Request</flowNodeRef><flowNodeRef>Task_Clarify</flowNodeRef><flowNodeRef>Task_Approve</flowNodeRef><flowNodeRef>Gateway_Approved</flowNodeRef><flowNodeRef>End_Declined</flowNodeRef></lane>
      <lane id="Lane_Manager" name="Менеджер"><flowNodeRef>Task_Register</flowNodeRef><flowNodeRef>Gateway_Complete</flowNodeRef><flowNodeRef>Task_Ask</flowNodeRef><flowNodeRef>Task_Offer</flowNodeRef></lane>
      <lane id="Lane_Logistics" name="Логист"><flowNodeRef>Task_Check</flowNodeRef><flowNodeRef>Gateway_Feasible</flowNodeRef><flowNodeRef>Task_Calculate</flowNodeRef><flowNodeRef>End_Rejected</flowNodeRef></lane>
      <lane id="Lane_Dispatch" name="Диспетчер"><flowNodeRef>Task_Assign</flowNodeRef><flowNodeRef>Task_Monitor</flowNodeRef><flowNodeRef>Gateway_Incident</flowNodeRef><flowNodeRef>Task_Resolve</flowNodeRef></lane>
      <lane id="Lane_Driver" name="Водитель"><flowNodeRef>Task_Load</flowNodeRef><flowNodeRef>Task_Deliver</flowNodeRef></lane>
      <lane id="Lane_Accounting" name="Бухгалтер"><flowNodeRef>Task_Documents</flowNodeRef><flowNodeRef>Task_Close</flowNodeRef><flowNodeRef>End_Closed</flowNodeRef></lane>
    </laneSet>
    <startEvent id="Start_Request" name="Потребность в перевозке" />
    <task id="Task_Request" name="Передать заявку" />
    <task id="Task_Register" name="Зарегистрировать заявку" />
    <exclusiveGateway id="Gateway_Complete" name="Данные полные?" />
    <task id="Task_Ask" name="Запросить уточнение" />
    <task id="Task_Clarify" name="Дополнить заявку" />
    <task id="Task_Check" name="Проверить возможность перевозки" />
    <exclusiveGateway id="Gateway_Feasible" name="Перевозка возможна?" />
    <endEvent id="End_Rejected" name="Мотивированный отказ" />
    <task id="Task_Calculate" name="Рассчитать маршрут, срок и цену" />
    <task id="Task_Offer" name="Передать предложение" />
    <task id="Task_Approve" name="Согласовать условия" />
    <exclusiveGateway id="Gateway_Approved" name="Условия приняты?" />
    <endEvent id="End_Declined" name="Заявка отменена" />
    <task id="Task_Assign" name="Назначить машину и водителя" />
    <task id="Task_Load" name="Принять груз и начать рейс" />
    <task id="Task_Monitor" name="Контролировать рейс" />
    <exclusiveGateway id="Gateway_Incident" name="Есть отклонение?" />
    <task id="Task_Resolve" name="Урегулировать отклонение" />
    <task id="Task_Deliver" name="Передать груз получателю" />
    <task id="Task_Documents" name="Проверить документы и выставить счёт" />
    <task id="Task_Close" name="Закрыть заказ" />
    <endEvent id="End_Closed" name="Заказ закрыт" />
    <sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Task_Request" /><sequenceFlow id="F02" sourceRef="Task_Request" targetRef="Task_Register" /><sequenceFlow id="F03" sourceRef="Task_Register" targetRef="Gateway_Complete" />
    <sequenceFlow id="F04" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_Ask" /><sequenceFlow id="F05" sourceRef="Task_Ask" targetRef="Task_Clarify" /><sequenceFlow id="F06" sourceRef="Task_Clarify" targetRef="Task_Register" />
    <sequenceFlow id="F07" name="Да" sourceRef="Gateway_Complete" targetRef="Task_Check" /><sequenceFlow id="F08" sourceRef="Task_Check" targetRef="Gateway_Feasible" /><sequenceFlow id="F09" name="Нет" sourceRef="Gateway_Feasible" targetRef="End_Rejected" />
    <sequenceFlow id="F10" name="Да" sourceRef="Gateway_Feasible" targetRef="Task_Calculate" /><sequenceFlow id="F11" sourceRef="Task_Calculate" targetRef="Task_Offer" /><sequenceFlow id="F12" sourceRef="Task_Offer" targetRef="Task_Approve" /><sequenceFlow id="F13" sourceRef="Task_Approve" targetRef="Gateway_Approved" />
    <sequenceFlow id="F14" name="Нет" sourceRef="Gateway_Approved" targetRef="End_Declined" /><sequenceFlow id="F15" name="Да" sourceRef="Gateway_Approved" targetRef="Task_Assign" /><sequenceFlow id="F16" sourceRef="Task_Assign" targetRef="Task_Load" /><sequenceFlow id="F17" sourceRef="Task_Load" targetRef="Task_Monitor" /><sequenceFlow id="F18" sourceRef="Task_Monitor" targetRef="Gateway_Incident" />
    <sequenceFlow id="F19" name="Да" sourceRef="Gateway_Incident" targetRef="Task_Resolve" /><sequenceFlow id="F20" sourceRef="Task_Resolve" targetRef="Task_Monitor" /><sequenceFlow id="F21" name="Нет" sourceRef="Gateway_Incident" targetRef="Task_Deliver" /><sequenceFlow id="F22" sourceRef="Task_Deliver" targetRef="Task_Documents" /><sequenceFlow id="F23" sourceRef="Task_Documents" targetRef="Task_Close" /><sequenceFlow id="F24" sourceRef="Task_Close" targetRef="End_Closed" />
  </process>
